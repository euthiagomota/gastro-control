# ====================================================
# GastroControl - Environment Variables Example
# Copie este arquivo para .env e configure as variáveis
# NÃO COMMITE O ARQUIVO .env NO GIT
# ====================================================

# ====================================================
# DATABASE CONFIGURATION
# ====================================================
# PostgreSQL connection details
DB_URL=jdbc:postgresql://localhost:5432/gastrocontrol
DB_USERNAME=gastrocontrol
DB_PASSWORD=gastrocontrol123

# ====================================================
# JWT SECURITY
# ====================================================
# IMPORTANTE: Altere o JWT_SECRET em produção!
# Gere uma string segura de pelo menos 256 bits (32+ caracteres)
# Exemplo: use: openssl rand -base64 32
JWT_SECRET=YWJjZGVmZ2hpamtsbW5vcHFyc3R1dnd4eXoKYWJjZGVmZ2hpamtsbW5vcHFyc3R1dnd4eXoKYWJjZGVm
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# ====================================================
# SERVER CONFIGURATION
# ====================================================
SERVER_PORT=8080

# ====================================================
# FRONTEND CONFIGURATION
# ====================================================
# URLs do frontend para CORS
FRONTEND_URL=http://localhost:5173

# ====================================================
# EMAIL CONFIGURATION (OPCIONAL)
# ====================================================
# Configuração de envio de emails
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=seu-email@gmail.com
MAIL_PASSWORD=sua-senha-app

# ====================================================
# FILE UPLOAD
# ====================================================
# Diretório para upload de arquivos
UPLOAD_DIR=uploads

# ====================================================
# ACTUATOR & MONITORING
# ====================================================
# Habilita endpoints do actuator para health checks
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics,env

# ====================================================
# LOGGING
# ====================================================
# Nível de logging: DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO
LOG_FILE=logs/gastrocontrol.log

# ====================================================
# DOCKER COMPOSE (se usar)
# ====================================================
# PostgreSQL container
POSTGRES_DB=gastrocontrol
POSTGRES_USER=gastrocontrol
POSTGRES_PASSWORD=gastrocontrol123
POSTGRES_PORT=5432

# PgAdmin (optional - para gerenciar DB via web)
PGADMIN_EMAIL=admin@gastrocontrol.com
PGADMIN_PASSWORD=admin123
PGADMIN_PORT=5050

